{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "System Blueprint",
  "description": "A comprehensive blueprint describing a software system, including its architecture, components, data models, APIs, and UI elements. Used as a specification for AI-driven generation.",
  "type": "object",
  "required": [
    "projectMetadata",
    "applicationType",
    "technologyStack",
    "infrastructureSpecification"
  ],
  "properties": {
    "projectMetadata": {
      "type": "object",
      "description": "Information about the blueprint itself and the project.",
      "required": [
        "blueprintName",
        "blueprintVersion",
        "projectName"
      ],
      "properties": {
        "blueprintName": {
          "type": "string",
          "description": "Name of this blueprint document."
        },
        "blueprintVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+.*$",
          "description": "Version of this blueprint document (e.g., 1.0.0)."
        },
        "projectName": {
          "type": "string",
          "description": "Name of the system or application being blueprinted."
        },
        "projectDescription": {
          "type": "string",
          "description": "A brief description of the system."
        },
        "targetEnvironments": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["development", "staging", "production", "testing", "UAT"]
          },
          "description": "List of target deployment environments."
        },
        "author": {
          "type": "string",
          "description": "Author or generating agent of this blueprint."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of blueprint creation."
        }
      },
      "additionalProperties": false
    },
    "applicationType": {
      "type": "string",
      "description": "The general type of application to be built.",
      "enum": [
        "web-application",
        "mobile-application",
        "api-service",
        "cli-tool",
        "agent-service",
        "desktop-application",
        "iot-system",
        "data-pipeline",
        "game",
        "blockchain-dapp",
        "other"
      ]
    },
    "technologyStack": {
      "type": "object",
      "description": "Defines the core technologies to be used.",
      "properties": {
        "frontend": {
          "$ref": "#/definitions/frontendSpecification"
        },
        "backend": {
          "$ref": "#/definitions/backendSpecification"
        },
        "database": {
          "$ref": "#/definitions/databaseSpecification"
        }
      },
      "additionalProperties": false
    },
    "infrastructureSpecification": {
      "type": "object",
      "description": "Details about the deployment infrastructure.",
      "required": ["cloudProvider", "deploymentModel"],
      "properties": {
        "cloudProvider": {
          "type": "string",
          "enum": ["AWS", "GCP", "Azure", "DigitalOcean", "Vercel", "Netlify", "Heroku", "Self-hosted", "Hybrid", "None", "Other"],
          "description": "Primary cloud provider."
        },
        "deploymentModel": {
          "type": "string",
          "enum": ["serverless", "containerized", "virtual-machines", "paas", "bare-metal"],
          "description": "Primary deployment model."
        },
        "containerization": {
          "type": "object",
          "properties": {
            "useDocker": {"type": "boolean", "default": true},
            "orchestration": {
              "type": ["string", "null"],
              "enum": ["Kubernetes (EKS/GKE/AKS)", "Docker Swarm", "AWS ECS", "Nomad", "None", "Other"],
              "description": "Container orchestration platform, if any."
            },
            "registry": {
              "type": ["string", "null"],
              "description": "e.g., Docker Hub, AWS ECR, GCP GCR, Azure ACR"
            }
          },
          "additionalProperties": false
        },
        "ciCdPipeline": {
          "type": "object",
          "properties": {
            "tool": {
              "type": "string",
              "enum": ["GitHub Actions", "GitLab CI", "Jenkins", "CircleCI", "Azure DevOps", "AWS CodePipeline", "Other"],
              "description": "CI/CD automation tool."
            },
            "stages": {
              "type": "array",
              "items": {"type": "string"},
              "description": "e.g., build, test, deploy-staging, deploy-production"
            }
          },
          "additionalProperties": false
        },
        "environmentVariables": {
          "type": "array",
          "description": "List of key environment variables needed, without their values.",
          "items": {
            "type": "object",
            "properties": {
              "name": {"type": "string"},
              "description": {"type": "string"},
              "scope": {"type": "string", "enum": ["build-time", "run-time"]}
            },
            "required": ["name", "scope"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "dataModels": {
      "type": "array",
      "description": "Defines the data entities and their structures.",
      "items": {
        "$ref": "#/definitions/databaseTableDefinition"
      }
    },
    "apiEndpoints": {
      "type": "array",
      "description": "For services, defines the API endpoints.",
      "items": {
        "$ref": "#/definitions/apiEndpoint"
      }
    },
    "uiSpecification": {
      "type": "object",
      "description": "Detailed specification for UI applications.",
      "properties": {
        "pages": {
          "type": "array",
          "items": { "$ref": "#/definitions/frontendPage" }
        },
        "components": {
          "type": "array",
          "items": { "$ref": "#/definitions/frontendComponent" }
        }
      },
      "additionalProperties": false
    },
    "agentServices": {
      "type": "array",
      "description": "For systems involving AI agents, defines individual agent services.",
      "items": {
        "$ref": "#/definitions/agentService"
      }
    },
    "workflowsAutomations": {
      "type": "array",
      "description": "Descriptions of key automated business processes or agentic workflows.",
      "items": {
        "$ref": "#/definitions/workflowDefinition"
      }
    },
    "aiAgentIntegration": {
      "type": "object",
      "description": "Details for integrating AI/LLM capabilities within the generated application itself.",
      "properties": {
        "llmProvider": {
          "type": "string",
          "enum": ["OpenAI", "Anthropic", "Google Gemini", "Ollama", "HuggingFace", "Azure OpenAI", "AWS Bedrock", "None", "Other"],
          "description": "LLM provider for built-in AI features."
        },
        "modelId": {
          "type": "string",
          "description": "Specific LLM model ID (e.g., gpt-4, claude-3-opus, llama3)."
        },
        "agentTasks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "taskName": {"type": "string"},
              "description": {"type": "string"},
              "promptTemplate": {"type": "string"},
              "expectedOutputFormat": {"type": "string", "enum": ["text", "json", "code", "markdown"]}
            },
            "required": ["taskName", "description"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "blockchainWeb3Integration": {
      "type": "object",
      "description": "Details for blockchain or Web3 integration.",
      "properties": {
        "useBlockchain": {"type": "boolean", "default": false},
        "network": {
          "type": ["string", "null"],
          "enum": ["Ethereum", "Polygon", "Solana", "Avalanche", "BNB Chain", "Arbitrum", "Optimism", "Other", "Private"],
          "description": "Target blockchain network."
        },
        "smartContracts": {
          "type": "array",
          "items": { "$ref": "#/definitions/smartContractDetail" }
        },
        "walletIntegration": {
          "type": ["string", "null"],
          "enum": ["MetaMask", "WalletConnect", "Coinbase Wallet", "Phantom", "None", "Other"],
          "description": "Wallet integration method or library."
        },
        "dAppFeatures": {
          "type": "array",
          "items": {"type": "string"},
          "description": "List of key DApp functionalities (e.g., token interaction, NFT minting)."
        }
      },
      "additionalProperties": false
    },
    "testingStrategy": {
      "type": "object",
      "description": "Approach for testing different aspects of the system.",
      "properties": {
        "unitTestFramework": {"type": "string", "description": "e.g., Jest, Pytest, JUnit, Go Test"},
        "integrationTestFramework": {"type": "string", "description": "e.g., Supertest, Testcontainers, Spring Test"},
        "e2eTestFramework": {"type": "string", "description": "e.g., Cypress, Playwright, Selenium"},
        "performanceTestTool": {"type": ["string", "null"], "description": "e.g., K6, JMeter, Locust"},
        "coverageGoals": {
          "type": "object",
          "properties": {
            "unit": {"type": "integer", "minimum": 0, "maximum": 100},
            "integration": {"type": "integer", "minimum": 0, "maximum": 100}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "documentationRequirements": {
      "type": "object",
      "description": "Specifications for project documentation.",
      "properties": {
        "apiDocsTool": {
          "type": "string",
          "enum": ["Swagger/OpenAPI UI", "Redoc", "Docusaurus", "MkDocs", "Sphinx", "None", "Other"],
          "description": "Tool for generating/hosting API documentation."
        },
        "userManualStyle": {
          "type": "string",
          "enum": ["Markdown files", "Wiki (e.g., Confluence, GitHub Wiki)", "Dedicated Docs Site"],
          "description": "Format or platform for user manuals."
        },
        "includeArchitectureDiagrams": {"type": "boolean", "default": true},
        "autoGenerateChangelogs": {"type": "boolean", "default": true}
      },
      "additionalProperties": false
    },
    "securityConsiderations": {
      "type": "object",
      "description": "Security-related requirements and design notes.",
      "properties": {
        "authentication": {
          "type": "string",
          "description": "e.g., JWT, OAuth2, SAML, API Keys, WebAuthn"
        },
        "authorization": {
          "type": "string",
          "description": "e.g., Role-Based Access Control (RBAC), Attribute-Based Access Control (ABAC)"
        },
        "dataEncryption": {
          "type": "string",
          "description": "Notes on data at rest and in transit encryption."
        },
        "complianceRequirements": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "e.g., GDPR, HIPAA, PCI-DSS, SOC2"
        },
        "threatModelConsiderations": {
          "type": "string",
          "description": "Key threats considered and mitigation strategies."
        }
      },
      "additionalProperties": false
    },
    "scalabilityConsiderations": {
      "type": "object",
      "description": "Notes on expected scale and scalability features.",
      "properties": {
        "expectedLoad": {
          "type": "string",
          "description": "e.g., concurrent users, requests per second, data volume"
        },
        "scalingStrategy": {
          "type": "string",
          "description": "e.g., Horizontal scaling, vertical scaling, auto-scaling groups, serverless auto-scaling, database read replicas"
        },
        "performanceTargets": {
          "type": "string",
          "description": "e.g., p95 latency < 200ms, uptime > 99.9%"
        }
      },
      "additionalProperties": false
    }
  },
  "definitions": {
    "frontendSpecification": {
      "type": "object",
      "description": "Detailed frontend technology choices and structure.",
      "required": ["framework", "language"],
      "properties": {
        "framework": {
          "type": "string",
          "enum": ["React", "Vue", "Angular", "Svelte", "Next.js", "Nuxt.js", "Astro", "SolidJS", "Flutter", "React Native", "SwiftUI", "Jetpack Compose", "MAUI", "Electron", "Tauri", "None", "Other"],
          "description": "Primary frontend framework/library."
        },
        "language": {
          "type": "string",
          "enum": ["JavaScript", "TypeScript", "Dart", "Swift", "Kotlin", "CSharp", "Python", "Rust"],
          "description": "Primary programming language for frontend."
        },
        "uiLibrary": {
          "type": ["string", "null"],
          "enum": ["Tailwind CSS", "Material-UI (MUI)", "Chakra UI", "Bootstrap", "Ant Design", "Vuetify", "Shadcn/ui", "None", "Custom", "Other"],
          "description": "Main UI component library or framework."
        },
        "stateManagement": {
          "type": ["string", "null"],
          "enum": ["Redux", "Zustand", "Pinia", "Vuex", "NgRx", "Context API + Hooks", "Riverpod (Flutter)", "Bloc (Flutter)", "None", "Other"],
          "description": "State management solution."
        },
        "routing": {
          "type": ["string", "null"],
          "enum": ["React Router", "Vue Router", "Next.js Router", "Angular Router", "GoRouter (Flutter)", "None", "Other"],
          "description": "Client-side or server-side routing library."
        },
        "keyLibraries": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of other key frontend libraries (e.g., axios, SWR, TanStack Query)."
        }
      },
      "additionalProperties": false
    },
    "backendSpecification": {
      "type": "object",
      "description": "Detailed backend technology choices and structure.",
      "required": ["language", "framework"],
      "properties": {
        "language": {
          "type": "string",
          "enum": ["Python", "JavaScript", "TypeScript", "Java", "CSharp", "Go", "Ruby", "PHP", "Rust", "Kotlin", "Scala"],
          "description": "Primary programming language for backend."
        },
        "framework": {
          "type": "string",
          "enum": ["FastAPI", "Flask", "Django", "Express.js", "NestJS", "Koa.js", "Spring Boot", "Micronaut", "Quarkus", "Ruby on Rails", "Sinatra", "Go Gin", "Echo (Go)", "Fiber (Go)", "ASP.NET Core", "Actix-web (Rust)", "Axum (Rust)", "Laravel (PHP)", "Symfony (PHP)", "None", "Other"],
          "description": "Primary backend framework."
        },
        "apiType": {
          "type": "string",
          "enum": ["REST", "GraphQL", "gRPC", "WebSocket", "Hybrid"],
          "default": "REST",
          "description": "Primary API paradigm."
        },
        "authenticationMethod": {
          "type": ["string", "null"],
          "enum": ["JWT", "OAuth 2.0", "Session-based", "API Keys", "OpenID Connect", "SAML", "None", "Other"],
          "description": "Authentication mechanism."
        },
        "keyLibraries": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of other key backend libraries (e.g., Celery, Kafka clients, specific SDKs)."
        },
        "modules": {
          "type": "array",
          "items": { "$ref": "#/definitions/backendModule" }
        }
      },
      "additionalProperties": false
    },
    "databaseSpecification": {
      "type": "object",
      "description": "Detailed database technology choices and structure.",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["PostgreSQL", "MySQL", "MariaDB", "SQLite", "MongoDB", "DynamoDB", "Firebase Firestore", "Redis", "Elasticsearch", "Cassandra", "Neo4j", "InfluxDB", "TimescaleDB", "CockroachDB", "SurrealDB", "None", "Other"],
          "description": "Primary database type."
        },
        "ormOdm": {
          "type": ["string", "null"],
          "enum": ["SQLAlchemy", "Prisma", "TypeORM", "Sequelize", "Mongoose", "Django ORM", "SQLModel", "PonyORM", "Peewee", "None", "Other"],
          "description": "ORM or ODM library."
        },
        "hosting": {
          "type": ["string", "null"],
          "enum": ["Self-hosted", "AWS RDS", "Azure SQL Database", "GCP Cloud SQL", "MongoDB Atlas", "AWS DynamoDB", "Firebase", "DigitalOcean Managed DB", "Other Managed Service"],
          "description": "Database hosting solution."
        },
        "schemaDefinitions": {
          "type": "array",
          "items": { "$ref": "#/definitions/databaseTableDefinition" }
        }
      },
      "additionalProperties": false
    },
    "databaseTableDefinition": {
      "type": "object",
      "description": "Definition of a database table or collection.",
      "required": ["name", "columns"],
      "properties": {
        "name": {"type": "string"},
        "description": {"type": "string"},
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "properties": {
              "name": {"type": "string"},
              "type": {"type": "string", "description": "e.g., VARCHAR(255), INTEGER, TEXT, BOOLEAN, TIMESTAMP, JSONB, UUID"},
              "isPrimaryKey": {"type": "boolean", "default": false},
              "isForeignKey": {"type": "boolean", "default": false},
              "foreignKeyTable": {"type": ["string", "null"]},
              "foreignKeyColumn": {"type": ["string", "null"]},
              "isNullable": {"type": "boolean", "default": true},
              "isUnique": {"type": "boolean", "default": false},
              "isIndexed": {"type": "boolean", "default": false},
              "defaultValue": {"type": ["string", "number", "boolean", "null"]},
              "description": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "targetTable", "foreignKey"],
            "properties": {
              "type": {"type": "string", "enum": ["one-to-one", "one-to-many", "many-to-one", "many-to-many"]},
              "targetTable": {"type": "string"},
              "foreignKey": {"type": "string", "description": "Column name in this table that is the FK."},
              "targetTableForeignKey": {"type": ["string", "null"], "description": "Column name in the target table (for many-to-many via join table, or if FK is on target)."},
              "joinTable": {"type": ["string", "null"], "description": "Name of the join table for many-to-many relationships."}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "apiEndpoint": {
      "type": "object",
      "required": ["path", "method", "summary"],
      "properties": {
        "path": {"type": "string", "description": "e.g., /users/{id}"},
        "method": {"type": "string", "enum": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS", "HEAD"]},
        "summary": {"type": "string"},
        "description": {"type": "string"},
        "tags": {"type": "array", "items": {"type": "string"}},
        "requestBodySchema": {
          "type": ["object", "string", "null"],
          "description": "Reference to a dataModel/databaseTableDefinition or an inline JSON schema for the request body."
        },
        "responseBodySchema": {
          "type": "object",
          "description": "Map of status codes to response schemas.",
          "additionalProperties": {
            "type": ["object", "string", "null"],
            "description": "Reference to a dataModel/databaseTableDefinition or an inline JSON schema."
          }
        },
        "queryParameters": {
          "type": "array",
          "items": { "$ref": "#/definitions/apiParameter" }
        },
        "pathParameters": {
          "type": "array",
          "items": { "$ref": "#/definitions/apiParameter" }
        },
        "headerParameters": {
          "type": "array",
          "items": { "$ref": "#/definitions/apiParameter" }
        },
        "authenticationRequired": {"type": "boolean", "default": false},
        "permissions": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "apiParameter": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": {"type": "string"},
        "type": {"type": "string", "enum": ["string", "number", "integer", "boolean", "array"]},
        "format": {"type": ["string", "null"], "description": "e.g., uuid, date-time, int64"},
        "description": {"type": "string"},
        "required": {"type": "boolean", "default": false},
        "example": {}
      },
      "additionalProperties": false
    },
    "frontendPage": {
      "type": "object",
      "required": ["name", "routePath"],
      "properties": {
        "name": {"type": "string", "description": "e.g., UserDashboardPage, ProductListingPage"},
        "routePath": {"type": "string", "description": "e.g., /dashboard, /products"},
        "description": {"type": "string"},
        "layout": {"type": ["string", "null"], "description": "Reference to a layout component name."},
        "childComponents": {"type": "array", "items": {"type": "string"}, "description": "Names of key child components used on this page."},
        "dataSources": {"type": "array", "items": {"type": "string"}, "description": "API endpoints or state stores it relies on."},
        "userActions": {"type": "array", "items": {"type": "string"}, "description": "Key actions a user can perform on this page."}
      },
      "additionalProperties": false
    },
    "frontendComponent": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "description": "e.g., UserProfileCard, ProductGridItem"},
        "description": {"type": "string"},
        "props": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {"type": "string"},
              "type": {"type": "string"},
              "isRequired": {"type": "boolean", "default": false}
            },
            "required": ["name", "type"]
          }
        },
        "emittedEvents": {"type": "array", "items": {"type": "string"}},
        "dataSources": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "backendModule": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "description": "e.g., AuthenticationModule, OrderProcessingModule"},
        "description": {"type": "string"},
        "responsibilities": {"type": "array", "items": {"type": "string"}},
        "keyClassesOrFunctions": {"type": "array", "items": {"type": "string"}},
        "dependencies": {"type": "array", "items": {"type": "string"}, "description": "Other backend modules it depends on."}
      },
      "additionalProperties": false
    },
    "agentService": {
      "type": "object",
      "required": ["name", "goal"],
      "properties": {
        "name": {"type": "string"},
        "description": {"type": "string"},
        "goal": {"type": "string"},
        "triggers": {"type": "array", "items": {"type": "string"}},
        "inputs": {"type": "array", "items": {"$ref": "#/definitions/agentIOParameter"}},
        "outputs": {"type": "array", "items": {"$ref": "#/definitions/agentIOParameter"}},
        "required_tools_ref": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "agentIOParameter": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": {"type": "string"},
        "type": {"type": "string"},
        "description": {"type": "string"}
      },
      "additionalProperties": false
    },
    "smartContractDetail": {
      "type": "object",
      "required": ["name", "language"],
      "properties": {
        "name": {"type": "string"},
        "description": {"type": "string"},
        "language": {"type": "string", "enum": ["Solidity", "Vyper", "Rust (Ink!, Anchor)", "Move", "Other"]},
        "keyFunctions": {"type": "array", "items": {"type": "string"}},
        "stateVariables": {"type": "array", "items": {"type": "string"}},
        "events": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "workflowDefinition": {
      "type": "object",
      "required": ["name", "steps"],
      "properties": {
        "name": {"type": "string"},
        "description": {"type": "string"},
        "trigger": {"type": "string"},
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["stepName", "actor", "actions"],
            "properties": {
              "stepName": {"type": "string"},
              "description": {"type": "string"},
              "actor": {"type": "string"},
              "actions": {"type": "array", "items": {"type": "string"}},
              "outputs": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
```

**Summary of Key Changes and Additions:**

*   **`projectMetadata`**: Added `projectName` (required) and `targetEnvironments`.
*   **`technologyStack`**:
    *   **`frontend`**: Changed to `$ref: "#/definitions/frontendSpecification"`.
    *   **`backend`**: Changed to `$ref: "#/definitions/backendSpecification"`.
    *   **`database`**: Changed to `$ref: "#/definitions/databaseSpecification"`.
*   **`infrastructureSpecification`**: (Previously `deploymentPlatform`)
    *   Renamed and expanded.
    *   Added `cloudProvider` (enum), `deploymentModel` (enum).
    *   Nested `containerization` object (Docker, orchestration, registry).
    *   Nested `ciCdPipeline` object (tool, stages).
    *   Nested `environmentVariables` array of objects.
*   **`dataModels`**: Changed `items` to `$ref: "#/definitions/databaseTableDefinition"`.
*   **`uiComponents`**: Renamed to `uiSpecification` and split into `pages` and `components` arrays, referencing new definitions.
*   **New Top-Level Sections Added**:
